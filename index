<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="#4A90D9">
  <title>赵老师数学错题集</title>
  <!-- Vant & Vue -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vant@4.8.0/lib/index.css">
  <script src="https://unpkg.com/vue@3.4.0/dist/vue.global.js"></script>
  <script src="https://unpkg.com/vue-router@4.2.5/dist/vue-router.global.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/vant@4.8.0/lib/vant.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5.0.5/dist/tesseract.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/idb@8.0.0/build/umd.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; user-select: none; }
    body { background: #F5F6FA; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; color: #2C3E50; padding: 16px 12px 32px; }
    #app { max-width: 560px; margin: 0 auto; background: #F5F6FA; min-height: 100vh; border-radius: 32px; }
    .btn-primary { background: #FF8C42; border: none; border-radius: 60px; padding: 12px 16px; font-weight: 600; font-size: 16px; color: white; width: 100%; text-align: center; cursor: pointer; transition: transform 0.1s, background 0.2s; box-shadow: 0 4px 8px rgba(255,140,66,0.2); }
    .btn-primary:active { transform: scale(0.97); background: #e67e22; }
    .btn-secondary { background: #4A90D9; border: none; border-radius: 60px; padding: 12px 16px; font-weight: 600; font-size: 16px; color: white; width: 100%; text-align: center; cursor: pointer; }
    .btn-outline { background: white; border: 1px solid #4A90D9; border-radius: 60px; padding: 10px 16px; font-weight: 500; color: #4A90D9; text-align: center; cursor: pointer; }
    .card { background: white; border-radius: 28px; padding: 20px; margin-bottom: 20px; box-shadow: 0 8px 20px rgba(0,0,0,0.04); }
    .global-header { display: flex; justify-content: space-between; align-items: baseline; text-align: center; margin-bottom: 24px; flex-wrap: wrap; }
    .header-left { flex: 1; text-align: center; }
    .org-name { font-size: 0.75rem; letter-spacing: 2px; color: #2C3E50; opacity: 0.7; }
    .main-title { font-family: "Comic Sans MS", "Chalkboard SE", cursive; font-size: 1.6rem; font-weight: 700; color: #FF8C42; line-height: 1.3; }
    .role-badge { background: #ECF0F1; border-radius: 40px; padding: 4px 12px; font-size: 0.7rem; color: #2C3E50; white-space: nowrap; }
    .section-title { font-size: 1.2rem; font-weight: 600; color: #2C3E50; margin-bottom: 12px; border-left: 4px solid #FF8C42; padding-left: 12px; }
    .grid-answer { display: grid; grid-template-columns: repeat(20, 1fr); background-image: linear-gradient(to right, #ccc 1px, transparent 1px), linear-gradient(to bottom, #ccc 1px, transparent 1px); background-size: 20px 20px; border: 1px solid #ddd; height: 80px; border-radius: 16px; margin: 8px 0; }
    .a4-container { width: 210mm; min-height: 297mm; margin: 0 auto; padding: 15mm; background: white; position: relative; box-sizing: border-box; }
    .watermark { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(-45deg); font-size: 22px; color: rgba(0,0,0,0.05); white-space: nowrap; pointer-events: none; }
    .van-nav-bar { background: #F5F6FA !important; --van-nav-bar-icon-color: #4A90D9; }
    .van-nav-bar__title { color: #2C3E50 !important; font-weight: 500; }
    .bottom-btn { margin-top: 20px; margin-bottom: 10px; }
    .role-btn { margin: 8px 0; padding: 10px; background: #ECF0F1; border-radius: 60px; text-align: center; cursor: pointer; }
    .role-btn.active { background: #FF8C42; color: white; }
    .topic-item { background: #F8F9FC; border-radius: 60px; padding: 12px 18px; margin: 8px 0; display: flex; justify-content: space-between; cursor: pointer; }
    .example-box { background: #FEF5E8; border-radius: 24px; padding: 16px; margin-bottom: 20px; border-left: 6px solid #FF8C42; }
    .example-analysis { background: #F0F4F8; padding: 10px; border-radius: 20px; font-size: 14px; margin-top: 8px; }
    .pagination { display: flex; justify-content: center; gap: 16px; margin-top: 20px; }
  </style>
</head>
<body>
<div id="app"><router-view></router-view></div>
<script>
  const { createApp, ref, reactive, computed, onMounted, watch } = Vue;
  const { createRouter, createWebHashHistory } = VueRouter;

  // ================== 年级列表与题库映射 ==================
  const gradeList = [
    "一年级上册", "一年级下册", "二年级上册", "二年级下册",
    "三年级上册", "三年级下册", "四年级上册", "四年级下册",
    "五年级上册", "五年级下册", "六年级上册", "六年级下册"
  ];
  
  // 四年级下册完整42个考点数据（精简展示，实际可扩展）
  const allSubCategories = [
    "四则运算", "根据算式列综合算式", "加减法、乘除法各部分之间的关系", "错中求解应用题", "有余数的除法应用题（进一法、去尾法）",
    "观察物体", "加法的简便运算", "乘法的简便运算", "连减的简便运算", "除法的运算性质", "凑整简便运算", "租车、乘船问题最优方案",
    "购票问题", "小数的意义和性质", "小数的加减法", "小数点移动引起小数大小的变化", "小数加减法的简便计算", "小数与单位换算",
    "小数的近似数", "三角形的分类", "三角形的内角和", "多边形的内角和", "三角形三条边的关系", "已知三角形两条边，求第三边取值范围",
    "已知三角形周长，求长边最长是多少", "轴对称图形", "平移", "平均数", "条形统计图", "鸡兔同笼 - 假设法", "鸡兔同笼 - 打包法",
    "鸡兔同笼 - 倒扣分类型", "鸡兔同笼 - 吃馒头问题", "鸡兔同笼 - 鸡兔互换型", "还原问题 - 逆推运算", "搭配问题 - 分类加法、分类乘法",
    "行程问题", "买赠问题", "周期增减问题", "和差问题", "和倍问题", "差倍问题"
  ];
  // 构建考点对象（每个考点包含典型例题占位和练习示例）
  const grade4Data = {
    subCategories: allSubCategories.map(name => ({
      name: name,
      core: { question: "典型例题：待填充", answer: "", analysis: "此处将在后续版本中加入详细解析" },
      exercises: [
        { question: `【示例】${name}相关的练习题1`, answer: "参考答案待补充" },
        { question: `【示例】${name}相关的练习题2`, answer: "参考答案待补充" }
      ]
    }))
  };

  const getGradeTopics = (grade) => {
    if (grade === "四年级下册") return grade4Data.subCategories;
    return [{ name: "示例讲（开发中）", core: null, exercises: [] }];
  };

  // ================== IndexedDB 错题库 & 用户库 ==================
  let dbPromise = null;
  const initDB = async () => {
    if(dbPromise) return dbPromise;
    const { openDB } = window.idb;
    dbPromise = openDB('ZhaoMathDB', 5, {
      upgrade(db) {
        if(!db.objectStoreNames.contains('mistakes')) {
          const store = db.createObjectStore('mistakes', { keyPath: 'id', autoIncrement: true });
          store.createIndex('userId', 'userId'); store.createIndex('status', 'status');
        }
        if(!db.objectStoreNames.contains('users')) db.createObjectStore('users', { keyPath: 'id' });
        if(!db.objectStoreNames.contains('reports')) db.createObjectStore('reports', { keyPath: 'id', autoIncrement: true });
      }
    });
    return dbPromise;
  };
  const addUser = async (user) => { const db = await initDB(); return db.put('users', user); };
  const addMistake = async (mistake) => { const db = await initDB(); return db.add('mistakes', { ...mistake, createdAt: Date.now(), status: 'pending' }); };
  const getMistakesByStatus = async (status, userId = null) => { const db = await initDB(); const all = await db.getAll('mistakes'); return all.filter(m => m.status === status && (userId ? m.userId === userId : true)); };
  const updateMistake = async (id, updates) => { const db = await initDB(); const m = await db.get('mistakes', id); if(m) { Object.assign(m, updates); return db.put('mistakes', m); } };
  const getMistakesByUser = async (userId) => { const db = await initDB(); const all = await db.getAll('mistakes'); return all.filter(m => m.userId === userId); };
  const getAllStudents = async () => { const db = await initDB(); const users = await db.getAll('users'); return users.filter(u => u.role === 'student'); };
  const addReport = async (report) => { const db = await initDB(); return db.add('reports', report); };

  // 用户会话
  const currentUser = ref(null);
  const selectedStudentId = ref(null);
  const login = (user) => { currentUser.value = user; localStorage.setItem('zhaoUser', JSON.stringify(user)); if(user.role === 'teacher') selectedStudentId.value = null; else selectedStudentId.value = user.id; };
  const logout = () => { currentUser.value = null; localStorage.removeItem('zhaoUser'); selectedStudentId.value = null; window.location.hash = '#/login'; };
  const loadSession = () => { const stored = localStorage.getItem('zhaoUser'); if(stored) currentUser.value = JSON.parse(stored); };
  const getCurrentViewStudentId = computed(() => {
    if(!currentUser.value) return null;
    if(currentUser.value.role === 'teacher') return selectedStudentId.value;
    return currentUser.value.id;
  });

  const showWechat = () => { vant.showDialog({ title: '📱 添加老师微信', message: '微信号：zhaolaoshi_math', confirmButtonText: '复制' }).then(()=>{ navigator.clipboard.writeText('zhaolaoshi_math'); vant.showToast('已复制'); }); };

  // 路由
  const routes = [
    { path: '/', redirect: '/login' },
    { path: '/login', component: { template: '<LoginPage />' } },
    { path: '/register', component: { template: '<RegisterPage />' } },
    { path: '/index', component: { template: '<HomePage />' }, meta: { auth: true } },
    { path: '/mistakes/capture', component: { template: '<CapturePage />' }, meta: { auth: true, roles: ['student','teacher'] } },
    { path: '/mistakes/my', component: { template: '<MyMistakes />' }, meta: { auth: true, roles: ['student','teacher'] } },
    { path: '/mistakes/review', component: { template: '<ReviewPage />' }, meta: { auth: true, roles: ['teacher'] } },
    { path: '/mistakes/stats', component: { template: '<StatsPage />' }, meta: { auth: true, roles: ['student','teacher'] } },
    { path: '/exercises/topics', component: { template: '<TopicsList />' }, meta: { auth: true } },
    { path: '/exercises/generate', component: { template: '<GeneratePage />' }, meta: { auth: true } },
    { path: '/exercises/print', component: { template: '<PrintWorksheet />' }, meta: { auth: true } }
  ];
  const router = createRouter({ history: createWebHashHistory(), routes });
  router.beforeEach((to, from, next) => {
    if(to.meta?.auth && !currentUser.value) next('/login');
    else if(to.meta?.roles && !to.meta.roles.includes(currentUser.value?.role)) next('/index');
    else next();
  });

  // ========== 全局头部组件（显示角色） ==========
  const GlobalHeader = {
    setup() {
      const roleName = computed(() => {
        if(!currentUser.value) return '';
        return currentUser.value.role === 'student' ? '学生' : '老师';
      });
      return { roleName };
    },
    template: `
      <div class="global-header">
        <div class="header-left">
          <div class="org-name">贝贝塔教育</div>
          <div class="main-title">赵老师数学错题集</div>
        </div>
        <div class="role-badge">{{ roleName }}</div>
      </div>
    `
  };

  // ========== 页面组件 ==========
  const LoginPage = { setup(){ const un=ref(''),pw=ref(''); const doLogin=async()=>{ if(!un.value) return vant.showToast('请输入用户名'); const db=await initDB(); const users=await db.getAll('users'); const u=users.find(u=>u.username===un.value && u.password===pw.value); if(u){ login(u); router.push('/index'); vant.showToast('登录成功'); }else vant.showToast('用户名或密码错误'); }; const router=VueRouter.useRouter(); return { username:un, password:pw, doLogin, router }; }, template:`<div><GlobalHeader /><div class="card"><div class="form-group"><label>用户名</label><input v-model="username" placeholder="学生/老师" style="width:100%; padding:12px; border-radius:60px; border:1px solid #ddd;" /></div><div class="form-group"><label>密码</label><input type="password" v-model="password" placeholder="密码" style="width:100%; padding:12px; border-radius:60px; border:1px solid #ddd;" /></div><button class="btn-primary" @click="doLogin">登录</button><button class="btn-outline" style="margin-top:12px;" @click="router.push('/register')">注册新账号</button></div></div>` };
  const RegisterPage = { setup(){ const un=ref(''),pw=ref('123'),role=ref('student'),selectedGrade=ref('四年级下册'); const doReg=async()=>{ if(!un.value.trim()) return vant.showToast('请输入用户名'); const db=await initDB(); const exists=await db.get('users',un.value); if(exists) return vant.showToast('用户名已存在'); const newUser={ id:un.value, username:un.value, password:pw.value, role:role.value, grade:selectedGrade.value }; await addUser(newUser); login(newUser); router.push('/index'); vant.showToast('注册成功'); }; const router=VueRouter.useRouter(); return { username:un, password:pw, role, selectedGrade, doReg, router }; }, template:`<div><GlobalHeader /><div class="card"><div class="form-group"><label>用户名</label><input v-model="username" style="width:100%; padding:12px; border-radius:60px; border:1px solid #ddd;" /></div><div class="form-group"><label>密码</label><input type="password" v-model="password" style="width:100%; padding:12px; border-radius:60px;" /></div><div class="form-group"><label>身份</label><div><button class="role-btn" :class="{active:role==='student'}" @click="role='student'">学生</button><button class="role-btn" :class="{active:role==='teacher'}" @click="role='teacher'">老师</button></div></div><div class="form-group"><label>年级</label><select v-model="selectedGrade" style="width:100%; padding:12px; border-radius:60px;"><option v-for="g in gradeList" :value="g">{{g}}</option></select></div><button class="btn-primary" @click="doReg">注册并登录</button></div></div>` };
  
  const HomePage = { setup(){ const user=currentUser; const router=VueRouter.useRouter(); const students=ref([]); const loadStudents=async()=>{ if(user.value?.role==='teacher') students.value=await getAllStudents(); }; onMounted(loadStudents); const selectStudent=(id)=>{ selectedStudentId.value=id; vant.showToast(`已切换至学生`); }; return { user, router, students, selectedStudentId, selectStudent, showWechat, logout }; }, template:`<div><GlobalHeader /><div class="card"><div v-if="user?.role==='teacher'" class="teacher-selector"><van-cell title="查看学生错题" is-link><template #right><select v-model="selectedStudentId" @change="selectStudent(selectedStudentId)" style="padding:8px; border-radius:40px;"><option :value="null">-- 请选择学生 --</option><option v-for="s in students" :key="s.id" :value="s.id">{{ s.username }}</option></select></template></van-cell></div><div class="card" style="background:#F0F4F8;" @click="router.push('/mistakes/capture')"><div class="section-title">📸 错题拍照</div></div><div v-if="user?.role==='student'" class="card" @click="router.push('/mistakes/my')"><div class="section-title">📘 错题集</div></div><div v-if="user?.role==='student'" class="card" @click="router.push('/mistakes/stats')"><div class="section-title">📊 学情分析</div></div><div v-if="user?.role==='teacher'" class="card" @click="router.push('/mistakes/review')"><div class="section-title">✅ 错题审核</div></div><div v-if="user?.role==='teacher'" class="card" @click="router.push('/mistakes/stats')"><div class="section-title">📈 学情雷达</div></div><div class="card" @click="router.push('/exercises/topics')"><div class="section-title">📚 经典题型工坊</div></div><button class="btn-outline" style="margin-top:12px;" @click="logout">退出登录</button></div></div>` };

  // 错题拍照（保留完整功能）
  const CapturePage = { setup(){ const imagePreview=ref(null); const recognizedText=ref(''); const loading=ref(false); const onFileChange=async(e)=>{ const file=e.target.files[0]; if(!file) return; imagePreview.value=URL.createObjectURL(file); loading.value=true; try{ const {data:{text}}=await Tesseract.recognize(file,'chi_sim+eng'); recognizedText.value=text; vant.showToast('识别完成'); }catch(e){ recognizedText.value='识别失败'; } finally{ loading.value=false; } }; const submit=async()=>{ if(!recognizedText.value) return vant.showToast('请先拍照识别'); await addMistake({ userId:currentUser.value.id, studentAnswer:recognizedText.value, image:imagePreview.value, studentName:currentUser.value.username }); vant.showToast('已提交审核'); router.push('/index'); }; const triggerFile=()=>{ document.getElementById('cameraInput').click(); }; const router=VueRouter.useRouter(); const goBack=()=>router.back(); return { imagePreview, recognizedText, loading, onFileChange, submit, triggerFile, goBack }; }, template:`<div><GlobalHeader /><van-nav-bar title="拍照录入" left-arrow @click-left="goBack"/><div class="card"><input type="file" id="cameraInput" accept="image/*" capture="environment" style="display:none;" @change="onFileChange" /><button class="btn-primary" @click="triggerFile">📷 拍照/相册</button><div v-if="imagePreview"><img :src="imagePreview" style="max-width:100%; border-radius:20px; margin:12px 0;" /></div><van-loading v-if="loading"/><textarea v-model="recognizedText" rows="3" placeholder="识别结果" style="width:100%; margin:12px 0; border-radius:20px; padding:12px;"></textarea><button class="btn-primary" @click="submit">提交审核</button><div class="bottom-btn"><button class="btn-outline" @click="goBack">🔙 返回上一页</button></div></div></div>` };
  const MyMistakes = { setup(){ const mistakes=ref([]); const load=async()=>{ const uid=getCurrentViewStudentId.value; if(!uid) return; const all=await getMistakesByUser(uid); mistakes.value=all.filter(m=>m.status==='approved'); }; const printMistake=(m)=>{ router.push({ path:'/exercises/print', query:{ type:'mistake', data:JSON.stringify(m) } }); }; onMounted(load); watch(()=>getCurrentViewStudentId.value, load); const router=VueRouter.useRouter(); const goBack=()=>router.back(); return { mistakes, printMistake, router, goBack }; }, template:`<div><GlobalHeader /><van-nav-bar title="错题本" left-arrow @click-left="goBack"/><div class="card"><div v-for="m in mistakes" style="border-bottom:1px solid #eee; padding:12px;"><div>答案：{{ m.studentAnswer }}</div><button class="btn-outline" style="margin-top:8px;" @click="printMistake(m)">打印预览</button></div><div v-if="!mistakes.length">暂无错题</div><div class="bottom-btn"><button class="btn-outline" @click="goBack">🔙 返回上一页</button></div></div></div>` };
  // 错题审核（增加学生筛选下拉）
  const ReviewPage = { setup(){ const pending=ref([]); const editAnswers=reactive({}); const students=ref([]); const selectedStudentForReview=ref(null); const loadStudents=async()=>{ students.value = await getAllStudents(); }; const loadPending=async()=>{ const uid = selectedStudentForReview.value || null; pending.value = await getMistakesByStatus('pending', uid); pending.value.forEach(m=>{ editAnswers[m.id]=m.studentAnswer; }); }; const approve=async(id)=>{ await updateMistake(id,{status:'approved', studentAnswer:editAnswers[id]}); loadPending(); vant.showToast('已入库'); }; const reject=async(id)=>{ await updateMistake(id,{status:'rejected'}); loadPending(); }; onMounted(()=>{ loadStudents(); loadPending(); }); watch(selectedStudentForReview, loadPending); const router=VueRouter.useRouter(); const goBack=()=>router.back(); return { pending, editAnswers, approve, reject, router, goBack, students, selectedStudentForReview }; }, template:`<div><GlobalHeader /><van-nav-bar title="错题审核" left-arrow @click-left="goBack"/><div class="card"><div class="form-group"><label>筛选学生：</label><select v-model="selectedStudentForReview" style="width:100%; padding:10px; border-radius:40px;"><option :value="null">所有学生</option><option v-for="s in students" :key="s.id" :value="s.id">{{ s.username }}</option></select></div><div v-for="m in pending" style="border-bottom:1px solid #eee; padding:12px;"><div>学生：{{ m.studentName }}</div><div>识别：{{ m.studentAnswer }}</div><input v-model="editAnswers[m.id]" style="width:100%; border-radius:40px; padding:8px;" /><button class="btn-primary" @click="approve(m.id)">确认入库</button><button class="btn-outline" @click="reject(m.id)">驳回</button></div><div v-if="!pending.length">暂无待审核错题</div><div class="bottom-btn"><button class="btn-outline" @click="goBack">🔙 返回上一页</button></div></div></div>` };
  // 学情雷达（老师端增加学生筛选，学生端显示自己的统计）
  const StatsPage = { setup(){ const stats=ref([]); const students=ref([]); const selectedStudentForStats=ref(null); const loadStudents=async()=>{ if(currentUser.value?.role==='teacher') students.value = await getAllStudents(); }; const loadStats=async()=>{ const db=await initDB(); let all=await db.getAll('mistakes'); let targetUserId = null; if(currentUser.value.role === 'teacher'){ targetUserId = selectedStudentForStats.value; } else { targetUserId = currentUser.value.id; } if(targetUserId) all = all.filter(m => m.userId === targetUserId); const approved = all.filter(m => m.status === 'approved'); const map = new Map(); approved.forEach(m=>{ if(!map.has(m.userId)) map.set(m.userId,{userId:m.userId,topics:{}}); const u=map.get(m.userId); u.topics[m.topic||'其他']=(u.topics[m.topic||'其他']||0)+1; }); stats.value = Array.from(map.values()); }; onMounted(()=>{ loadStudents(); loadStats(); }); watch(selectedStudentForStats, loadStats); const router=VueRouter.useRouter(); const goBack=()=>router.back(); return { stats, students, selectedStudentForStats, router, goBack, isTeacher: currentUser.value?.role === 'teacher' }; }, template:`<div><GlobalHeader /><van-nav-bar title="学情分析" left-arrow @click-left="goBack"/><div class="card"><div v-if="isTeacher" class="form-group"><label>筛选学生：</label><select v-model="selectedStudentForStats" style="width:100%; padding:10px; border-radius:40px;"><option :value="null">所有学生</option><option v-for="s in students" :key="s.id" :value="s.id">{{ s.username }}</option></select></div><div v-for="u in stats" style="border-bottom:1px solid #eee; padding:12px;"><div>学生ID: {{ u.userId }}</div><div>高频错点: {{ Object.entries(u.topics).sort((a,b)=>b[1]-a[1]).slice(0,3).map(t=>t[0]).join(', ') || '暂无' }}</div></div><div v-if="!stats.length">暂无数据</div><div class="bottom-btn"><button class="btn-outline" @click="goBack">🔙 返回上一页</button></div></div></div>` };
  
  // 经典题型工坊（年级下拉12个选项 + 分页）
  const TopicsList = { 
    setup(){ 
      const router = VueRouter.useRouter(); 
      const selectedGrade = ref("四年级下册"); 
      const allTopics = computed(() => getGradeTopics(selectedGrade.value));
      const pageSize = 10;
      const currentPage = ref(1);
      const totalPages = computed(() => Math.ceil(allTopics.value.length / pageSize));
      const paginatedTopics = computed(() => {
        const start = (currentPage.value - 1) * pageSize;
        return allTopics.value.slice(start, start + pageSize);
      });
      const nextPage = () => { if(currentPage.value < totalPages.value) currentPage.value++; };
      const prevPage = () => { if(currentPage.value > 1) currentPage.value--; };
      const selectCategory = (cat) => {
        if(selectedGrade.value !== "四年级下册") { vant.showToast('其他年级题库开发中，敬请期待'); return; }
        router.push({ path:'/exercises/generate', query:{ grade: selectedGrade.value, category:cat.name } });
      };
      const goBack = () => router.back();
      // 年级切换时重置页码
      watch(selectedGrade, () => { currentPage.value = 1; });
      return { gradeList, selectedGrade, paginatedTopics, currentPage, totalPages, nextPage, prevPage, selectCategory, goBack };
    },
    template: `
      <div><GlobalHeader /><van-nav-bar title="经典题型工坊" left-arrow @click-left="goBack"/><div class="card"><div class="form-group"><label>📖 选择年级</label><select v-model="selectedGrade" style="width:100%; padding:12px; border-radius:60px;"><option v-for="g in gradeList" :value="g">{{g}}</option></select></div><div v-for="cat in paginatedTopics" class="topic-item" @click="selectCategory(cat)">{{cat.name}} →</div><div class="pagination"><button class="btn-outline" @click="prevPage" :disabled="currentPage===1">上一页</button><span style="line-height:40px;">第 {{ currentPage }} / {{ totalPages }} 页</span><button class="btn-outline" @click="nextPage" :disabled="currentPage===totalPages">下一页</button></div><div class="bottom-btn"><button class="btn-outline" @click="goBack">🔙 返回上一页</button></div></div></div>
    `
  };
  
  const GeneratePage = { setup(){ const route=VueRouter.useRoute(); const router=VueRouter.useRouter(); const categoryName=ref(route.query.category); const categoryData=computed(()=>{ if(route.query.grade !== "四年级下册") return null; return grade4Data.subCategories.find(c=>c.name===categoryName.value); }); const coreExample=computed(()=>categoryData.value?.core); const exercises=computed(()=>categoryData.value?.exercises||[]); const printExercises=()=>{ router.push({ path:'/exercises/print', query:{ title:`${categoryName.value} 举一反三`, questions:JSON.stringify(exercises.value) } }); }; const goBack=()=>router.back(); return { categoryName, coreExample, exercises, printExercises, router, goBack }; }, template:`<div><GlobalHeader /><van-nav-bar :title="categoryName" left-arrow @click-left="goBack"/><div class="card"><div v-if="coreExample" class="example-box"><div>典型例题：{{ coreExample.question }}</div><div>答案：{{ coreExample.answer || '待补充' }}</div><div class="example-analysis">解析：{{ coreExample.analysis || '待补充' }}</div></div><div class="section-title">📝 举一反三</div><div v-for="(ex,idx) in exercises" style="margin-bottom:20px;"><div>{{idx+1}}. {{ ex.question }}</div><div class="grid-answer"></div><div style="font-size:12px; color:gray;">参考答案：{{ ex.answer }}</div></div><button class="btn-primary" @click="printExercises">🖨️ 打印练习卷</button><div class="bottom-btn"><button class="btn-outline" @click="goBack">🔙 返回上一页</button></div></div></div>` };
  const PrintWorksheet = { components:{ GridAnswer:{ template:`<div class="grid-answer"></div>` } }, setup(){ const route=VueRouter.useRoute(); const router=VueRouter.useRouter(); let questions=[], title='练习卷'; try{ if(route.query.type==='mistake'){ const m=JSON.parse(route.query.data); questions=[{question:`错题原图+答案：${m.studentAnswer}`,answer:''}]; title='错题打印'; }else{ questions=JSON.parse(route.query.questions||'[]'); title=route.query.title||'练习卷'; } }catch(e){} const exportPDF=async()=>{ const el=document.querySelector('.a4-container'); if(!el) return; const canvas=await html2canvas(el,{scale:2}); const imgData=canvas.toDataURL('image/png'); const pdf=new jspdf.jsPDF({unit:'mm',format:'a4'}); const imgProps=pdf.getImageProperties(imgData); const w=pdf.internal.pageSize.getWidth(); const h=(imgProps.height*w)/imgProps.width; pdf.addImage(imgData,'PNG',0,0,w,h); pdf.save(`${title}.pdf`); }; const goBack=()=>router.back(); return { questions, title, exportPDF, router, goBack }; }, template:`<div><GlobalHeader /><van-nav-bar title="打印预览" left-arrow @click-left="goBack"/><div class="a4-container"><div class="watermark">贝贝塔教育 赵老师数学错题集</div><h2 style="text-align:center;">{{title}}</h2><div v-for="(q,idx) in questions"><div>{{idx+1}}. {{ q.question }}</div><GridAnswer /></div></div><div class="no-print" style="padding:20px; text-align:center;"><button class="btn-primary" @click="exportPDF">导出PDF</button><div class="bottom-btn"><button class="btn-outline" @click="goBack">🔙 返回上一页</button></div></div></div>` };

  const app = createApp({ template: '<router-view />' });
  app.use(router);
  for(let k in vant) if(k !== 'install') app.component(k, vant[k]);
  app.component('GlobalHeader', GlobalHeader);
  app.component('LoginPage', LoginPage); app.component('RegisterPage', RegisterPage);
  app.component('HomePage', HomePage); app.component('CapturePage', CapturePage);
  app.component('MyMistakes', MyMistakes); app.component('ReviewPage', ReviewPage);
  app.component('StatsPage', StatsPage); app.component('TopicsList', TopicsList);
  app.component('GeneratePage', GeneratePage); app.component('PrintWorksheet', PrintWorksheet);
  app.mount('#app');
  loadSession();
</script>
</body>
</html>
